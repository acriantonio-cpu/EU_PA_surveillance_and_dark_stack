# EN: Copy this file to .env (git-ignored) and fill in your values. Never commit .env.
#     SCRAPER_CONTACT = contact shown in the crawler User-Agent; the two API keys are optional
#     and used only by the threat check (tools/postprocess_checkpoints.py).
# Copia questo file in .env (che è in .gitignore) e inserisci i tuoi valori.
# NON committare né condividere .env (né in zip): se una chiave è finita in un archivio o in un repo,
# ruotala dal pannello del provider.

# Contatto (email o URL) che compare nello User-Agent del crawler: "eu-pa-scraper/1.0 (+contatto)".
# Permette ai gestori dei siti di scrivervi invece di bannare l'IP. CONSIGLIATO.
SCRAPER_CONTACT=

# Chiavi opzionali per il controllo minacce (tools/postprocess_checkpoints.py)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
